<Window x:Class="_0916.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_0916"
        mc:Ignorable="d"
        Title="登入系統" Height="270" Width="445">
    <Grid>
        <Label Content="登入系統" HorizontalAlignment="Left" Margin="149,20,0,0" VerticalAlignment="Top" Height="55" Width="158" FontSize="32"/>

        <!-- 帳號 -->
        <Label Content="帳號" HorizontalAlignment="Left" Margin="31,90,0,0" VerticalAlignment="Top" Height="35" Width="45" FontSize="18"/>
        <TextBox x:Name="txtUsername" HorizontalAlignment="Left" Margin="87,93,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="180" Height="30" TextChanged="TextBox_TextChanged" FontSize="18"/>

        <!-- 密碼 -->
        <Label Content="密碼" HorizontalAlignment="Left" Margin="31,135,0,0" VerticalAlignment="Top" Height="29" Width="45" FontSize="18"/>
        <PasswordBox x:Name="txtPassword" HorizontalAlignment="Left" Margin="88,138,0,0" VerticalAlignment="Top" Width="180" Height="30" PasswordChanged="PasswordBox_PasswordChanged" FontSize="18"/>

        <!-- 登入按鈕 (加入 Click 事件) -->
        <Button Content="登入" HorizontalAlignment="Left" Margin="285,93,0,0" VerticalAlignment="Top" Height="75" Width="110" FontSize="28" Click="BtnLogin_Click"/>

        <!-- 訊息提示 -->
        <TextBlock x:Name="txtMessage" HorizontalAlignment="Left" Margin="88,180,0,0" VerticalAlignment="Top" Width="307" Foreground="Red" FontSize="14"/>

    </Grid>
</Window>