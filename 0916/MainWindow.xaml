<Window x:Class="_0916.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登入系統" Height="270" Width="445"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Grid>
        <!-- RGB 動態流動漸層背景 -->
        <Grid.Background>
            <LinearGradientBrush x:Name="RgbBrush" StartPoint="0,0" EndPoint="1,1">
                <LinearGradientBrush.RelativeTransform>
                    <RotateTransform x:Name="BrushRotate" Angle="0" CenterX="0.5" CenterY="0.5"/>
                </LinearGradientBrush.RelativeTransform>
                <GradientStop Color="#FF007F" Offset="0.0"/>
                <GradientStop Color="#7928CA" Offset="0.33"/>
                <GradientStop Color="#0070F3" Offset="0.66"/>
                <GradientStop Color="#00DFD8" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetName="BrushRotate"
                                         Storyboard.TargetProperty="Angle"
                                         From="0" To="360" Duration="0:0:8"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <!-- 光點粒子畫布 -->
        <Canvas x:Name="ParticleCanvas" IsHitTestVisible="False"/>

        <!-- 介面元素 -->
        <Label Content="登入系統" HorizontalAlignment="Left" Margin="149,20,0,0" VerticalAlignment="Top" 
               Height="55" Width="158" FontSize="32" FontWeight="Bold" Foreground="White"/>

        <Label Content="帳號" HorizontalAlignment="Left" Margin="31,90,0,0" VerticalAlignment="Top" 
               Height="35" Width="45" FontSize="18" Foreground="White"/>
        <TextBox x:Name="txtUsername" HorizontalAlignment="Left" Margin="87,93,0,0" 
                 VerticalAlignment="Top" Width="180" Height="30" FontSize="18" 
                 Background="#B3FFFFFF" BorderThickness="0" VerticalContentAlignment="Center"/>

        <Label Content="密碼" HorizontalAlignment="Left" Margin="31,135,0,0" VerticalAlignment="Top" 
               Height="29" Width="45" FontSize="18" Foreground="White"/>
        <PasswordBox x:Name="txtPassword" HorizontalAlignment="Left" Margin="88,138,0,0" 
                     VerticalAlignment="Top" Width="180" Height="30" FontSize="18" 
                     Background="#B3FFFFFF" BorderThickness="0" VerticalContentAlignment="Center"/>

        <Button Content="登入" HorizontalAlignment="Left" Margin="285,93,0,0" VerticalAlignment="Top" 
                Height="75" Width="110" FontSize="26" FontWeight="Bold" 
                Background="#D9FFFFFF" Cursor="Hand" Click="BtnLogin_Click"/>

        <TextBlock x:Name="txtMessage" HorizontalAlignment="Left" Margin="88,180,0,0" VerticalAlignment="Top" 
                   Width="307" Foreground="#FFE600" FontWeight="Bold" FontSize="14"/>
    </Grid>
</Window>