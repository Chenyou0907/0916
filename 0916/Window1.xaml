<Window x:Class="_0916.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_0916"
        mc:Ignorable="d"
        Title="Window1" Height="440" Width="930"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#2B2D42">
        <!-- 標題 -->
        <Label Content="登入成功" HorizontalAlignment="Left" Margin="113,40,0,0" VerticalAlignment="Top" 
               Height="45" Width="140" FontSize="26" FontWeight="Bold" Foreground="White"/>

        <!-- 姓名輸入 -->
        <Label Content="姓名" HorizontalAlignment="Left" Margin="28,122,0,0" VerticalAlignment="Top" 
               Height="34" Width="55" FontSize="18" Foreground="White"/>
        <TextBox x:Name="txtName" HorizontalAlignment="Left" Margin="97,122,0,0" VerticalAlignment="Top" 
                 Width="230" Height="34" FontSize="18"
                 Background="#FFFFFF" BorderThickness="1" BorderBrush="#CCCCCC" VerticalContentAlignment="Center"/>

        <!-- 電話輸入 -->
        <Label Content="電話" HorizontalAlignment="Left" Margin="28,172,0,0" VerticalAlignment="Top" 
               Height="34" Width="55" FontSize="18" Foreground="White"/>
        <TextBox x:Name="txtPhone" HorizontalAlignment="Left" Margin="97,172,0,0" VerticalAlignment="Top" 
                 Width="230" Height="34" FontSize="18"
                 Background="#FFFFFF" BorderThickness="1" BorderBrush="#CCCCCC" VerticalContentAlignment="Center"/>

        <!-- 送出按鈕 -->
        <Button Content="送出" HorizontalAlignment="Left" Margin="118,225,0,0" VerticalAlignment="Top" 
                Height="37" Width="100" FontSize="22" FontWeight="Bold" Background="#E0E0E0" 
                Cursor="Hand" Click="SubmitButton_Click"/>

        <!-- 九九乘法表輸入 -->
        <Label Content="輸入數字" HorizontalAlignment="Left" Margin="10,295,0,0" VerticalAlignment="Top" 
               FontSize="20" FontWeight="Bold" Foreground="White"/>
        <TextBox x:Name="txtNumber" HorizontalAlignment="Left" Margin="115,298,0,0" VerticalAlignment="Top" 
                 Width="140" Height="30" FontSize="18" TextChanged="TextBox_TextChanged_1"
                 Background="#FFFFFF" BorderThickness="1" BorderBrush="#CCCCCC" VerticalContentAlignment="Center"/>

        <!-- 結果顯示區 -->
        <Border Margin="353,20,20,20" Background="#1E1E24" CornerRadius="8" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBlock x:Name="txtResult" TextWrapping="NoWrap" FontFamily="Consolas" 
                           FontSize="15" Foreground="#00FFCC" Text="請輸入數字產生乘法表..."/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>